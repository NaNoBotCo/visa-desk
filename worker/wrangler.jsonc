{
  "name": "visa-desk-intake",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "vars": {
    "SITE_ORIGIN": "https://chiangmaivisadesk.com",
    "ORIGIN_CODE": "CMVD",
    "MAIL_FROM": "desk@chiangmaivisadesk.com"
    // DESK_RECIPIENTS is a secret, not a var — the desk's addresses stay out of
    // this repository.  wrangler secret put DESK_RECIPIENTS
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "visa-desk", "database_id": "PUT-THE-D1-ID-HERE" }
  ]
}
